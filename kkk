from flask import Flask, render_template_string, request, redirect, url_for, session, flash
from flask_sqlalchemy import SQLAlchemy
import os

app = Flask(__name__)
app.secret_key = 'coffe_edu_secret_key'

# Banco de dados SQLite
basedir = os.path.abspath(os.path.dirname(__file__))
app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///' + os.path.join(basedir, 'coffe_edu.db')
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False

db = SQLAlchemy(app)

# ------------------- MODELOS -------------------
class Usuario(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    nome = db.Column(db.String(100))
    email = db.Column(db.String(100), unique=True)
    senha = db.Column(db.String(100))
    admin = db.Column(db.Boolean, default=False)

class Produto(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    nome = db.Column(db.String(100))
    preco = db.Column(db.Float)
    descricao = db.Column(db.String(255))
    imagem = db.Column(db.String(255))

# ------------------- HTML BASE -------------------
base_html = '''
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Coffe Edu ☕</title>
    <style>
        body { background-color: #fff8f2; color: #3e2723; font-family: 'Poppins', sans-serif; }
        .bg-brown { background-color: #5d4037; color:white; padding:10px;}
        .btn-brown { background-color: #795548; color: white; padding:5px 10px; text-decoration:none;}
        .btn-brown:hover { background-color: #6d4c41; }
        .card { border:1px solid #ccc; border-radius:5px; padding:10px; margin:10px;}
    </style>
</head>
<body>
    <nav class="bg-brown">
        <a href="{{ url_for('index') }}" style="color:white; margin-right:10px;">☕ Coffe Edu</a>
        <a href="{{ url_for('menu') }}" style="color:white; margin-right:10px;">Cardápio</a>
        <a href="{{ url_for('sobre') }}" style="color:white; margin-right:10px;">Sobre</a>
