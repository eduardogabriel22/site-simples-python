# ------------------- ROTAS -------------------
@app.route('/')
def index():
    produtos = Produto.query.all()
    index_html = '''
    {% extends "base" %}
    {% block conteudo %}
    <h1>Bem-vindo à Coffe Edu ☕</h1>
    <div style="display:flex; flex-wrap:wrap;">
        {% for produto in produtos %}
        <div class="card" style="width:200px;">
            <img src="{{ produto.imagem }}" width="100%">
            <h4>{{ produto.nome }}</h4>
            <p>{{ produto.descricao }}</p>
            <p>R$ {{ produto.preco }}</p>
            <a href="#" class="btn-brown">Adicionar</a>
        </div>
        {% endfor %}
    </div>
    {% endblock %}
    '''
    return render_template_string(index_html, produtos=produtos, base=base_html)

